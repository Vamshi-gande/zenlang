let Node = fn(data) {
    return {
        "data": data,
        "next": null
    }
}

let appendHelper = fn(lst, value) {
    if (lst == null) {
        return Node(value)
    } else {
        return {
            "data": lst["data"],
            "next": appendHelper(lst["next"], value)
        }
    }
}

let removeHelper = fn(lst, index) {
    if (lst == null || index < 0) {
        return null
    }
    if (index == 0) {
        return lst["next"]
    } else {
        return {
            "data": lst["data"],
            "next": removeHelper(lst["next"], index - 1)
        }
    }
}

let getHelper = fn(lst, index) {
    if (lst == null || index < 0) {
        return null
    }
    if (index == 0) {
        return lst["data"]
    } else {
        return getHelper(lst["next"], index - 1)
    }
}

let sizeHelper = fn(lst) {
    if (lst == null) {
        return 0
    } else {
        return 1 + sizeHelper(lst["next"])
    }
}

let printHelper = fn(lst) {
    if (lst != null) {
        print(lst["data"])
        printHelper(lst["next"])
    }
}

let LinkedList = fn() {
    let head = null

    return {
        "append": fn(value) {
            head = appendHelper(head, value)
        },
        "prepend": fn(value) {
            head = {"data": value, "next": head}
        },
        "get": fn(index) {
            return getHelper(head, index)
        },
        "remove": fn(index) {
            head = removeHelper(head, index)
        },
        "size": fn() {
            return sizeHelper(head)
        },
        "isEmpty": fn() {
            return head == null
        },
        "print": fn() {
            printHelper(head)
        }
    }
}

let list = LinkedList()
list["append"](10)
list["append"](20)
list["prepend"](5)
print(list["size"]())
list["print"]()
print(list["get"](1))
list["remove"](1)
print(list["size"]())
list["print"]()