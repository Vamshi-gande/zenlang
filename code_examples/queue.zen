let Queue = fn() {
    let items = []
    return {
        "enqueue": fn(item) {
            items = push(items, item)
        },
        "dequeue": fn() {
            if (len(items) == 0) {
                return null
            }
            let item = items[0]
            let newItems = []
            let i = 1
            while (i < len(items)) {
                newItems = push(newItems, items[i])
                i = i + 1
            }
            items = newItems
            return item
        },
        "front": fn() {
            if (len(items) == 0) {
                return null
            }
            return items[0]
        },
        "isEmpty": fn() {
            return len(items) == 0
        },
        "size": fn() {
            return len(items)
        }
    }
}

let queue = Queue()
queue["enqueue"](1)
queue["enqueue"](2)
queue["enqueue"](3)
print(queue["size"]())
print(queue["front"]())
print(queue["dequeue"]())
print(queue["size"]())